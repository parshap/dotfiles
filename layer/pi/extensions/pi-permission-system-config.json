{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "authorizerChain": [
    "permission-reviewer"
  ],
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "*": "allow"
    },
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".netrc": "deny",
      ".git-credentials": "deny",
      "~/.ssh/*": "deny",
      "~/.aws/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.config/gh/hosts.yml": "deny",
      "~/.docker/config.json": "deny",
      "~/.pi/agent/auth.json": "deny"
    },
    "bash": {
      "*": "ask",
      "cd *": "allow",
      "pwd": "allow",
      "ls*": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "nl *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "uniq *": "allow",
      "diff *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "jq *": "allow",
      "date*": "allow",
      "uptime*": "allow",
      "ps*": "allow",
      "pgrep *": "allow",
      "sleep *": "allow",
      "true": "allow",
      "test *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "sort *": "allow",
      "sort *-o*": "ask",
      "sort *--output*": "ask",
      "sed -n *": "allow",
      "sed *-i*": "ask",
      "sed *--in-place*": "ask",
      "find *": "allow",
      "find *-delete*": "ask",
      "find *-fprint*": "ask",
      "find *-fls*": "ask",
      "mkdir *": "allow",
      "cp *": "allow",
      "tee *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch": "allow",
      "git branch --show-current": "allow",
      "git rev-parse *": "allow",
      "git ls-files*": "allow",
      "git blame *": "allow",
      "git fetch*": "allow",
      "git stash*": "allow",
      "git checkout *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "gh issue view *": "allow",
      "gh issue list*": "allow",
      "gh pr view *": "allow",
      "gh pr list*": "allow",
      "gh pr diff *": "allow",
      "npm view *": "allow",
      "dotfiles-layer status*": "allow",
      "dotfiles-layer diff*": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "cargo test*": "allow",
      "cargo build*": "allow",
      "cargo run*": "allow",
      "cargo fmt*": "allow",
      "cargo clippy*": "allow",
      "cargo check*": "allow",
      "npx tsc*": "allow",
      "npx biome *": "allow",
      "npx vitest*": "allow",
      "npx playwright *": "allow"
    }
  }
}
