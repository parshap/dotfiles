{
  "version": 1,
  "name": "personal",
  "priority": 10,
  "targets": {
    "pi-agents": {
      "strategy": "markdown-sections",
      "path": "~/.pi/agent/AGENTS.md",
      "mode": "0644"
    },
    "pi-keybindings": {
      "strategy": "symlink",
      "path": "~/.pi/agent/keybindings.json"
    },
    "pi-mcp": {
      "strategy": "json-patch",
      "path": "~/.pi/agent/mcp.json",
      "base": "empty",
      "mode": "0600"
    },
    "pi-mcp-client": {
      "strategy": "symlink",
      "path": "~/.pi/agent/mcp-client.yaml"
    },
    "pi-settings": {
      "strategy": "json-patch",
      "path": "~/.pi/agent/settings.json",
      "base": "empty",
      "preserve": [
        "/lastChangelogVersion"
      ],
      "mode": "0600"
    },
    "pi-statusline-config": {
      "strategy": "json-patch",
      "path": "~/.pi/agent/statusline.json",
      "base": "empty",
      "mode": "0600"
    },
    "pi-tool-manager": {
      "strategy": "symlink",
      "path": "~/.pi/agent/tool-manager.json"
    },
    "claude-instructions": {
      "strategy": "markdown-sections",
      "path": "~/.claude/CLAUDE.md",
      "mode": "0644"
    },
    "claude-settings": {
      "strategy": "json-patch",
      "path": "~/.claude/settings.json",
      "base": "live",
      "mode": "0600"
    },
    "pi-extension-refresh-screen": {
      "strategy": "symlink",
      "path": "~/.pi/agent/extensions/refresh-screen.ts"
    },
    "pi-extension-subagent-zone-profile": {
      "strategy": "symlink",
      "path": "~/.pi/agent/extensions/subagent-zone-profile.ts"
    },
    "pi-extension-statusline": {
      "strategy": "symlink",
      "path": "~/.pi/agent/extensions/statusline.ts"
    },
    "pi-extension-skill-projection-index": {
      "strategy": "symlink",
      "path": "~/.pi/agent/extensions/skill-projection/index.ts"
    },
    "pi-extension-skill-projection-readme": {
      "strategy": "symlink",
      "path": "~/.pi/agent/extensions/skill-projection/README.md"
    },
    "pi-lib-statusline-core": {
      "strategy": "symlink",
      "path": "~/.pi/agent/lib/statusline-core.mjs"
    },
    "pi-lib-statusline-promotions": {
      "strategy": "symlink",
      "path": "~/.pi/agent/lib/statusline-promotions.mjs"
    },
    "pi-lib-statusline-claude": {
      "strategy": "symlink",
      "path": "~/.pi/agent/lib/statusline-claude.mjs"
    },
    "zsh-fragments": {
      "strategy": "native-include",
      "app": "zsh"
    },
    "git-fragments": {
      "strategy": "native-include",
      "app": "git"
    },
    "tmux-fragments": {
      "strategy": "native-include",
      "app": "tmux"
    }
  },
  "contributions": [
    {
      "target": "zsh-fragments",
      "name": "brew",
      "path": "zsh/brew.zsh"
    },
    {
      "target": "zsh-fragments",
      "name": "rust",
      "path": "zsh/rust.zsh"
    },
    {
      "target": "zsh-fragments",
      "name": "mise",
      "path": "zsh/mise.zsh"
    },
    {
      "target": "claude-instructions",
      "path": "instructions/shared.md"
    },
    {
      "target": "claude-instructions",
      "path": "claude/CLAUDE.md"
    },
    {
      "target": "pi-agents",
      "path": "instructions/shared.md"
    },
    {
      "target": "pi-agents",
      "path": "pi/AGENTS.md"
    },
    {
      "target": "pi-keybindings",
      "path": "pi/keybindings.json"
    },
    {
      "target": "pi-mcp",
      "path": "pi/mcp.patch.json"
    },
    {
      "target": "pi-mcp-client",
      "path": "pi/mcp-client.yaml"
    },
    {
      "target": "pi-settings",
      "path": "pi/settings.patch.json"
    },
    {
      "target": "pi-statusline-config",
      "path": "pi/statusline.patch.json"
    },
    {
      "target": "pi-tool-manager",
      "path": "pi/tool-manager.json"
    },
    {
      "target": "claude-settings",
      "path": "claude/settings.patch.json"
    },
    {
      "target": "pi-extension-refresh-screen",
      "path": "pi/extensions/refresh-screen.ts"
    },
    {
      "target": "pi-extension-subagent-zone-profile",
      "path": "pi/extensions/subagent-zone-profile.ts"
    },
    {
      "target": "pi-extension-statusline",
      "path": "pi/extensions/statusline.ts"
    },
    {
      "target": "pi-extension-skill-projection-index",
      "path": "pi/extensions/skill-projection/index.ts"
    },
    {
      "target": "pi-extension-skill-projection-readme",
      "path": "pi/extensions/skill-projection/README.md"
    },
    {
      "target": "pi-lib-statusline-core",
      "path": "pi/lib/statusline-core.mjs"
    },
    {
      "target": "pi-lib-statusline-promotions",
      "path": "pi/lib/statusline-promotions.mjs"
    },
    {
      "target": "pi-lib-statusline-claude",
      "path": "pi/lib/statusline-claude.mjs"
    }
  ],
  "features": {
    "pi-permissions": {
      "targets": {
        "pi-permission-system-config": {
          "strategy": "symlink",
          "path": "~/.pi/agent/extensions/pi-permission-system/config.json"
        },
        "pi-extension-permission-reviewer": {
          "strategy": "symlink",
          "path": "~/.pi/agent/extensions/permission-reviewer"
        }
      },
      "contributions": [
        {
          "target": "pi-settings",
          "path": "pi/permissions/settings.patch.json"
        },
        {
          "target": "pi-permission-system-config",
          "path": "pi/permissions/pi-permission-system-config.json"
        },
        {
          "target": "pi-extension-permission-reviewer",
          "path": "pi/permissions/permission-reviewer"
        }
      ]
    },
    "pi-personal-providers": {
      "targets": {
        "pi-codex-compact-config": {
          "strategy": "json-patch",
          "path": "~/.pi/agent/pi-codex-compact.json",
          "base": "empty",
          "mode": "0600"
        },
        "pi-usage-config": {
          "strategy": "json-patch",
          "path": "~/.pi/agent/extensions/usage.json",
          "base": "empty",
          "mode": "0600"
        }
      },
      "contributions": [
        {
          "target": "pi-settings",
          "path": "pi/providers/settings.patch.json"
        },
        {
          "target": "pi-codex-compact-config",
          "path": "pi/providers/codex-compact.patch.json"
        },
        {
          "target": "pi-usage-config",
          "path": "pi/providers/usage.patch.json"
        }
      ]
    },
    "clerk-docs": {
      "targets": {
        "claude-skill-clerk-docs": {
          "strategy": "symlink",
          "path": "~/.claude/skills/clerk-docs"
        },
        "pi-plugin-clerk-docs": {
          "strategy": "symlink",
          "path": "~/.pi/agent/plugins/clerk-docs"
        }
      },
      "contributions": [
        {
          "target": "claude-skill-clerk-docs",
          "path": "agent-plugins/clerk-docs/skills/clerk-docs"
        },
        {
          "target": "pi-plugin-clerk-docs",
          "path": "agent-plugins/clerk-docs"
        },
        {
          "target": "pi-settings",
          "path": "pi/clerk-docs.patch.json"
        }
      ]
    },
    "pi-subagents": {
      "targets": {
        "pi-agent-explore": {
          "strategy": "symlink",
          "path": "~/.pi/agent/agents/explore.md"
        },
        "pi-agent-worker": {
          "strategy": "symlink",
          "path": "~/.pi/agent/agents/worker.md"
        },
        "pi-extension-subagent-foreground-guard": {
          "strategy": "symlink",
          "path": "~/.pi/agent/extensions/subagent-foreground-guard.ts"
        }
      },
      "contributions": [
        {
          "target": "pi-settings",
          "path": "pi/subagents/settings.patch.json"
        },
        {
          "target": "pi-agent-explore",
          "path": "pi/subagents/agents/explore.md"
        },
        {
          "target": "pi-agent-worker",
          "path": "pi/subagents/agents/worker.md"
        },
        {
          "target": "pi-extension-subagent-foreground-guard",
          "path": "pi/subagents/subagent-foreground-guard.ts"
        }
      ]
    },
    "ponytail": {
      "targets": {
        "ponytail-config": {
          "strategy": "json-patch",
          "path": "~/.config/ponytail/config.json",
          "base": "empty",
          "mode": "0600"
        }
      },
      "contributions": [
        {
          "target": "pi-settings",
          "path": "ponytail/pi-settings.patch.json"
        },
        {
          "target": "ponytail-config",
          "path": "ponytail/config.patch.json"
        }
      ]
    },
    "prompt-stash": {
      "contributions": [
        {
          "target": "pi-settings",
          "path": "pi/prompt-stash.patch.json"
        }
      ]
    }
  }
}
