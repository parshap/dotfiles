#!/usr/bin/env python3
"""Wrapper around Claude Code that auto-detects terminal background color
via OSC 11 and sets the theme in ~/.claude.json before launching.

Claude Code doesn't auto-detect terminal background color (see
https://github.com/anthropics/claude-code/issues/1076), so this wrapper
queries the terminal before each launch and updates the config if needed.
This works through tmux with `set -g allow-passthrough on`.
"""

import json
import os
import re
import select
import sys
import termios
import tty

CLAUDE_CONFIG = os.path.expanduser("~/.claude.json")


def find_real_claude():
    """Find the next 'claude' in PATH that isn't this wrapper script."""
    this_script = os.path.realpath(__file__)
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        candidate = os.path.join(directory, "claude")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            if os.path.realpath(candidate) != this_script:
                return candidate
    return None


def query_terminal_background():
    """Query the terminal's background color via OSC 11.

    Opens /dev/tty directly (rather than using stdin/stdout) so this works
    even when stdin/stdout are redirected or piped. Puts the terminal in raw
    mode to read the response bytes, then restores the original settings.

    Returns an (r, g, b) tuple of 0-255 values, or None if detection fails.
    """
    tty_fd = os.open("/dev/tty", os.O_RDWR)
    try:
        old_attrs = termios.tcgetattr(tty_fd)
        try:
            tty.setraw(tty_fd)
            # OSC 11 ; ? BEL - queries the terminal's background color
            os.write(tty_fd, b"\x1b]11;?\x07")
            # Read response with 500ms timeout. Terminal responds with:
            #   ESC ] 11 ; rgb:RRRR/GGGG/BBBB BEL
            # where each color component is 2 or 4 hex digits.
            response = b""
            while select.select([tty_fd], [], [], 0.5)[0]:
                response += os.read(tty_fd, 1024)
                if b"\x07" in response or b"\x1b\\" in response:
                    break
        finally:
            termios.tcsetattr(tty_fd, termios.TCSADRAIN, old_attrs)
    finally:
        os.close(tty_fd)

    # Match the rgb:XX/XX/XX portion (each component may be 2 or 4 hex digits)
    match = re.search(rb"rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)", response)
    if not match:
        return None

    # Normalize to 8-bit: take the first 2 hex digits of each component.
    # 4-digit values like "fbfb" become 0xfb=251, 2-digit values pass through.
    return tuple(int(ch.decode()[:2], 16) for ch in match.groups())


def perceived_luminance(r, g, b):
    """ITU-R BT.601 perceived luminance (0-255 scale)."""
    return 0.299 * r + 0.587 * g + 0.114 * b


def sync_theme():
    """Detect terminal background and update Claude Code theme if needed.

    Returns a message describing what happened, or None if no change was made.
    """
    rgb = query_terminal_background()
    if not rgb:
        raise RuntimeError("no OSC 11 response from terminal")

    theme = "light" if perceived_luminance(*rgb) > 128 else "dark"

    if not os.path.isfile(CLAUDE_CONFIG):
        return None

    with open(CLAUDE_CONFIG) as f:
        config = json.load(f)

    previous = config.get("theme")
    if previous == theme:
        return None

    config["theme"] = theme
    with open(CLAUDE_CONFIG, "w") as f:
        json.dump(config, f, indent=2)
        f.write("\n")

    return f"Detected {theme} terminal background, switching the Claude Code theme from {previous} to {theme}"


def main():
    claude = find_real_claude()
    if not claude:
        print("Error: could not find claude binary in PATH", file=sys.stderr)
        sys.exit(1)

    if sys.stdin.isatty() and sys.stdout.isatty():
        try:
            message = sync_theme()
            if message:
                print(message)
        except Exception as e:
            print(f"Warning: terminal background detection failed: {e}", file=sys.stderr)

    os.execv(claude, [claude] + sys.argv[1:])


if __name__ == "__main__":
    main()
